=wrap;html=1;strokeColor=#d6b656;fillColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1318" y="1681" width="104" height="38" as="geometry"/></mxCell><mxCell id="i_tasa" value="tasa_aplicada" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#d6b656;fillColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="786" y="1941" width="127" height="38" as="geometry"/></mxCell><mxCell id="i_val" value="valor_impuesto" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#d6b656;fillColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1293" y="1941" width="134" height="38" as="geometry"/></mxCell><mxCell id="sm_anio" value="anio" style="ellipse;fontStyle=4;whiteSpace=wrap;html=1;strokeColor=#666666;fillColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1968" y="171" width="104" height="38" as="geometry"/></mxCell><mxCell id="sm_val" value="valor_mensual" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#666666;fillColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2216" y="171" width="127" height="38" as="geometry"/></mxCell><mxCell id="nota_sm" value="Parámetro anual. El /salario de CAJERO (+ bono)&lt;br&gt;y de SERVICIOS_GENERALES se deriva del&lt;br&gt;salario mínimo del año en curso" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1970" y="375" width="360" height="50" as="geometry"/></mxCell><mxCell id="r_contrata" value="se contrata en" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1263" y="867" width="154" height="66" as="geometry"/></mxCell><mxCell id="r_registra" value="se registra en" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;fontSize=11;" vertex="1" parent="1"><mxGeometry x="723" y="977" width="154" height="66" as="geometry"/></mxCell><mxCell id="r_freg" value="fecha_registro" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#d79b00;fillColor=#ffffff;fontSize=11;" vertex="1" parent="1"><mxGeometry x="843" y="1081" width="134" height="38" as="geometry"/></mxCell><mxCell id="r_titular" value="es titular de" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;fontSize=11;" vertex="1" parent="1"><mxGeometry x="528" y="927" width="145" height="66" as="geometry"/></mxCell><mxCell id="r_abre" value="se abre en" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;fontSize=11;" vertex="1" parent="1"><mxGeometry x="815" y="1157" width="130" height="66" as="geometry"/></mxCell><mxCell id="r_procesa" value="procesa" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1315" y="1307" width="130" height="66" as="geometry"/></mxCell><mxCell id="r_realiza" value="se realiza en" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1028" y="1277" width="145" height="66" as="geometry"/></mxCell><mxCell id="r_clasifica" value="clasifica" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1335" y="1577" width="130" height="66" as="geometry"/></mxCell><mxCell id="r_origen" value="cuenta origen" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;fontSize=11;" vertex="1" parent="1"><mxGeometry x="808" y="1387" width="145" height="66" as="geometry"/></mxCell><mxCell id="r_destino" value="cuenta destino" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;fontSize=11;" vertex="1" parent="1"><mxGeometry x="613" y="1557" width="154" height="66" as="geometry"/></mxCell><mxCell id="r_genera" value="genera" style="rhombus;double=1;whiteSpace=wrap;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1035" y="1757" width="130" height="66" as="geometry"/></mxCell><mxCell id="r_provee" value="provee" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1925" y="1217" width="130" height="66" as="geometry"/></mxCell><mxCell id="nota" value="&lt;div style=&quot;line-height:20px&quot;&gt;&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;Rectángulo = entidad · doble borde = entidad débil&lt;br&gt;Elipse = atributo · subrayado = clave · doble elipse = multivalor&lt;br&gt;Elipse punteada (/x) = atributo derivado, no se almacena&lt;br&gt;Rombo = relación · doble rombo = relación identificante&lt;br&gt;(mín,máx) junto a una entidad = participación de esa entidad&lt;br&gt;Círculo d = disjunta · o = solapada · línea doble = total&lt;br&gt;Línea punteada roja = restricción: la pareja (titular, sucursal)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;debe&amp;nbsp;existir&amp;nbsp;ya&amp;nbsp;en&amp;nbsp;&amp;quot;se&amp;nbsp;registra&amp;nbsp;en&amp;quot;&lt;br&gt;&lt;br&gt;&lt;b&gt;Reglas del modelo (según los scripts 001–006)&lt;/b&gt;&lt;br&gt;• Solo personas mayores de 18 años.&lt;br&gt;• Vigilante ⇔ contrato TERCERIZADO, y nadie más lo es.&lt;br&gt;• Cuenta: solo de ahorro, saldo ≥ 0; CANCELADA ⇒ saldo = 0.&lt;br&gt;• La cuenta se abre solo en una sucursal donde el titular está&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;registrado&amp;nbsp;(pareja&amp;nbsp;cliente–sucursal).&lt;br&gt;• Depósito: solo destino · Retiro: solo origen ·&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;Transferencia:&amp;nbsp;origen&amp;nbsp;y&amp;nbsp;destino&amp;nbsp;distintos.&lt;br&gt;• Impuesto 4x1000 solo en retiros y transferencias; guarda la&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;tasa&amp;nbsp;aplicada&amp;nbsp;en&amp;nbsp;ese&amp;nbsp;momento&amp;nbsp;(1:1&amp;nbsp;con&amp;nbsp;la&amp;nbsp;transacción).&lt;br&gt;• Cajero: salario mínimo + bono · Serv. generales: salario&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;mínimo&amp;nbsp;·&amp;nbsp;Vigilante:&amp;nbsp;se&amp;nbsp;paga&amp;nbsp;por&amp;nbsp;hora.&lt;br&gt;• Historial inalterable: no se borran transacciones ni lo que&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;las&amp;nbsp;respalda&amp;nbsp;(cuentas,&amp;nbsp;cajeros,&amp;nbsp;sucursales).&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;strokeColor=#999999;fillColor=#ffffff;spacing=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1980" y="1598" width="560" height="504" as="geometry"/></mxCell><mxCell id="ed0" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="persona" target="isa1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed1" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="isa1" target="cliente"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed2" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="isa1" target="empleado"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed3" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;shape=link;" edge="1" parent="1" source="empleado" target="isa2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed4" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="isa2" target="cajero"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed5" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="isa2" target="servgen"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed6" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#333333;strokeWidth=1.5;fontSize=11;" edge="1" parent="1" source="isa2" target="vigilante"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ed7" value="" style="endArr